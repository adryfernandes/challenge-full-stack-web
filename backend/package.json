{
  "name": "painel-grupo-a",
  "version": "1.0.0",
  "description": "Painel administrativo do Grupo A",
  "main": "./build/index.js",
  "scripts": {
    "dev": "NODE_ENV=development ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/index.ts",
    "build": "npx tsc && npx tsc-alias",
    "clear:project": "rm -rf node_modules package-lock.json && npm run install:dependecies",
    "install:dependecies": "npm i --omit=dev",
    "remove:build": "rm -rf ./build",
    "typeorm": "NODE_OPTIONS='-r tsconfig-paths/register' typeorm-ts-node-commonjs -d ./src/database/dataSource.ts",
    "migration:generate": "npm run typeorm migration:generate ./src/database/migrations/default && eslint --fix ./**/migrations/*.{js,ts}",
    "migration:run": "npm run typeorm migration:run",
    "migration:revert": "npm run typeorm migration:revert",
    "doc:generate": "tsoa spec",
    "lint": "tsc --noEmit && eslint ./**/*.{js,ts}",
    "format": "prettier --write \"./**/*.{ts,js,css,md,json}\" --config ./.prettierrc",
    "before:build": "npm run lint:fix && npm run format && npm run lint"
  },
  "keywords": [],
  "author": "Adryane Fernandes",
  "license": "ISC",
  "dependencies": {
    "axios": "1.7.2",
    "bcryptjs": "2.4.3",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dayjs": "1.11.10",
    "dotenv": "16.3.1",
    "express": "4.19.2",
    "jsonwebtoken": "9.0.2",
    "mssql": "10.0.1",
    "qs": "6.12.3",
    "reflect-metadata": "0.1.13",
    "swagger-ui-express": "4.6.3",
    "tsc-alias": "1.8.8",
    "tsoa": "5.1.1",
    "typeorm": "0.3.20",
    "typeorm-extension": "3.5.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.15",
    "@types/express": "4.17.17",
    "@types/jsonwebtoken": "9.0.5",
    "@types/node": "20.11.18",
    "@types/swagger-ui-express": "4.1.3",
    "@typescript-eslint/eslint-plugin": "5.59.2",
    "@typescript-eslint/parser": "5.59.2",
    "eslint": "8.39.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-config-standard-with-typescript": "34.0.1",
    "eslint-import-resolver-typescript": "3.5.5",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-n": "15.0.0",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-promise": "6.0.0",
    "prettier": "2.8.8",
    "swagger-autogen": "2.23.4",
    "ts-node": "10.7.0",
    "ts-node-dev": "2.0.0",
    "typescript": "5.0.4"
  }
}
